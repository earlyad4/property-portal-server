SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.your-project:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

ADMIN_JWT_SECRET=generate-with-openssl-rand-hex-32
OPERATOR_BOOTSTRAP_EMAIL=operator@example.com
OPERATOR_BOOTSTRAP_PASSWORD=
CORS_ORIGINS=http://localhost:5173
SERVER_PORT=4317

# Runtime identity. CI should set RELEASE_ID to an immutable tag such as v1.3.2+abc1234.
APP_ENV=development
RELEASE_ID=property-portal-server-1.0.0-local

# Dependency-aware health and graceful shutdown
HEALTH_CHECK_TIMEOUT_MS=4000
MONITOR_INTERVAL_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
PUBLIC_BASE_URL=https://api.property-portal.example
REQUIRED_STORAGE_BUCKETS=building-photos

# Incident webhook accepting a JSON POST. Configure per environment and test delivery.
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_MS=5000

# Encrypted recovery mirror. In production, LOCAL_BACKUP_DIR should be a mounted,
# access-controlled company share reachable by the server or a dedicated backup worker.
BACKUP_ENABLED=false
LOCAL_BACKUP_DIR=./backups
BACKUP_CLOUD_BUCKET=property-portal-backups
BACKUP_SOURCE_BUCKETS=building-photos,documents,attachments
BACKUP_ENCRYPTION_KEY=generate-32-random-bytes-as-base64-or-64-hex-characters
BACKUP_INTERVAL_MS=86400000
BACKUP_ON_SHUTDOWN=false
SHUTDOWN_BACKUP_TIMEOUT_MS=30000

# Keep TLS certificate verification enabled. Set false only for a documented local test system.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional incident email delivery, disabled until configured.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_ESCALATION_TO=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
