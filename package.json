{
  "name": "property-portal-server",
  "version": "1.0.0",
  "description": "PropertyPortal backend — bridges the tenant mobile app and the admin desktop client",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node --check server.js && node --check lib/backup-service.js && node --check lib/operations-service.js && node --check lib/alert-service.js && node --check lib/client-version.js && node --check lib/runtime-state.js",
    "test": "node --test",
    "test:unit": "node --test test/*.test.js",
    "test:staging": "node --test test/staging-api.test.js",
    "validate:migrations": "node scripts/validate-migrations.js",
    "backup:create": "node scripts/create-backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "apply-migrations": "node scripts/apply-migrations.js",
    "demo": "node scripts/demo-server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "resend": "^6.20.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/earlyad4/property-portal-server.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
